POSTGRES_USER=jomi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jomiguard
MINIO_ROOT_USER=jomi
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=documents
DATABASE_URL=postgresql+psycopg://jomi:change_me@postgres:5432/jomiguard
TEST_DATABASE_URL=postgresql+psycopg://jomi:change_me@postgres:5432/jomiguard_test
# vision-LLM extraction (prices: USD per million tokens, from the provider's price list)
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL=model_id_here
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_DAILY_BUDGET_USD=1
LLM_MAX_TOKENS=8192
LLM_BUDGET_FILE=../data/llm/spend.json
LLM_CACHE_DIR=../data/cache/llm

# frontend & CORS
BACKEND_INTERNAL_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SESSION_SECRET=change_me
IDENTITY_PROVIDER=mock
BANK_PROVIDER=mock
# LLM provider: anthropic | gemini. Gemini free tier: synthetic documents only (CLAUDE.md)
LLM_PROVIDER=anthropic
GEMINI_API_KEY=your_gemini_api_key_here
# comma-separated, tried in order when a model's daily quota is used up
GEMINI_MODELS=model_id_1,model_id_2
